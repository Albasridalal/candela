# ---------------------------------------------------------------------------
# Supabase connection.
#
# Leave these unset to run the portal in DEMO MODE: the app boots with seeded
# sample requests held in memory so you can click through every screen without
# provisioning anything. Demo data resets when the server restarts.
#
# Fill them in (Supabase Dashboard > Project Settings > API) to switch to the
# real, persistent, multi-user database. No code change is needed.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
