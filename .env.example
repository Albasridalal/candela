# Supabase project settings — find these in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never exposed to the browser. Used only by
# the public booking API routes (src/app/api/public/**) so unauthenticated
# customers can check availability and create a booking under RLS-free,
# tightly scoped server code. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
