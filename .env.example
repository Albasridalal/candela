# Supabase project settings — Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY, never exposed to the browser. Used only by the
# public booking API routes (src/app/api/public/**) so unauthenticated customers
# can check availability and create a booking through tightly scoped server code.
# Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The timezone the salon's clock runs on (IANA name). Opening hours, working
# hours, the calendar grid and online booking slots are all read on this clock.
NEXT_PUBLIC_SALON_TIMEZONE=Asia/Kuwait
